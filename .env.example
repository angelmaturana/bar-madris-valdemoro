# URL pública del sitio (usada en canonical, sitemap, OG y JSON-LD).
PUBLIC_SITE_URL=http://localhost:8000

# Keepalive: mantiene el servicio activo en entornos que suspenden por inactividad
# (p. ej. Render free). Pinguea la URL indicada cada X segundos.
# Dejar vacío para desactivarlo (recomendado en local y durante los tests).
KEEPALIVE_URL=
KEEPALIVE_INTERVAL_SECONDS=300
KEEPALIVE_TIMEOUT_SECONDS=10